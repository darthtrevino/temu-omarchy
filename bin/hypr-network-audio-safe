#!/usr/bin/env bash

set -euo pipefail

watch_seconds=0
if (($# > 0)); then
    if [[ "${1:-}" != "--watch" || ! "${2:-}" =~ ^[0-9]+$ || $# -ne 2 ]]; then
        printf 'Usage: %s [--watch SECONDS]\n' "${0##*/}" >&2
        exit 2
    fi
    watch_seconds=$2
fi

deadline=$((SECONDS + watch_seconds))
while true; do
    failures=0
    mapfile -t sinks < <(
        pactl -f json list sinks 2>/dev/null |
            jq -r '.[] | select(.name | startswith("raop_sink.")) | .name'
    )

    for sink in "${sinks[@]}"; do
        if ! pactl set-sink-volume "$sink" 5% 2>/dev/null; then
            failures=$((failures + 1))
        fi
        if ! pactl set-sink-mute "$sink" 1 2>/dev/null; then
            failures=$((failures + 1))
        fi
    done

    if ((failures > 0)); then
        printf 'Unable to secure %s network audio setting(s).\n' "$failures" >&2
    fi

    ((SECONDS < deadline)) || break
    sleep 0.2
done
