#!/usr/bin/env bash

cat <<'EOF' | rofi -dmenu -i -matching fuzzy -p "Keybindings" -no-custom
SUPER + SPACE                    Applications
SUPER + K                        Keybinding help
SUPER + ESCAPE                   System menu
SUPER + M                        Log out
SUPER + RETURN                   Terminal
SUPER + SHIFT + RETURN           Browser
SUPER + SHIFT + F                File manager
SUPER + SHIFT + N                Editor
SUPER + SHIFT + ALT + M          CLIamp
SUPER + CTRL + T                 Activity monitor
SUPER + W / SUPER + Q            Close window
SUPER + T                        Toggle floating
SUPER + L                        Toggle scrolling layout
SUPER + J                        Toggle split
SUPER + P                        Toggle pseudo tiling
SUPER + F                        Fullscreen
SUPER + ALT + F                  Maximize
SUPER + ARROWS                   Focus window
SUPER + SHIFT + ARROWS           Swap window
ALT + TAB                        Next window
ALT + SHIFT + TAB                Previous window
CTRL + ALT + TAB                 Next monitor
CTRL + ALT + SHIFT + TAB         Previous monitor
SUPER + 1-0                      Switch workspace
SUPER + SHIFT + 1-0              Move window to workspace
SUPER + SHIFT + ALT + 1-0        Move window without following
SUPER + TAB                      Next workspace
SUPER + SHIFT + TAB              Previous workspace
SUPER + CTRL + TAB               Former workspace
SUPER + S / SUPER + GRAVE        Toggle scratchpad
SUPER + ALT + S                  Move window to scratchpad
SUPER + G                        Toggle window group
SUPER + ALT + G                  Remove window from group
SUPER + ALT + ARROWS             Move window into group
SUPER + ALT + TAB                Next grouped window
SUPER + ALT + SHIFT + TAB        Previous grouped window
SUPER + MINUS / EQUAL            Resize horizontally
SUPER + SHIFT + MINUS / EQUAL    Resize vertically
SUPER + SHIFT + SPACE            Toggle top bar
PRINT                            Screenshot screen
SHIFT + PRINT                    Screenshot region
SUPER + PRINT                    Screenshot active window
ALT + VOLUME UP / DOWN           Adjust volume by 1%
ALT + BRIGHTNESS UP / DOWN       Adjust brightness by 1%
SHIFT + BRIGHTNESS UP / DOWN     Maximum / minimum brightness
ALT + PLAY                       Next track
ALT + SHIFT + PLAY               Previous track
EOF
