#!/usr/bin/env bash

set -euo pipefail

sink_name="audio_effect.j416-convolver"
select_sink=false

for argument in "$@"; do
    case "$argument" in
        --select)
            select_sink=true
            ;;
        *)
            printf 'Unknown argument: %s\n' "$argument" >&2
            exit 2
            ;;
    esac
done

sink_available() {
    pactl -f json list sinks 2>/dev/null |
        jq -e --arg name "$sink_name" \
            '.[] | select(.name == $name)' >/dev/null
}

sink_id() {
    wpctl status -n 2>/dev/null |
        awk '/audio_effect\.j416-convolver/ && /\[Audio\/Sink\]/ {
            for (i = 1; i <= NF; ++i) {
                if ($i ~ /^[0-9]+\.$/) {
                    sub(/\.$/, "", $i)
                    print $i
                    exit
                }
            }
        }'
}

move_streams() {
    local input
    local failures=0

    while IFS= read -r input; do
        [[ -n "$input" ]] || continue
        if ! pactl move-sink-input "$input" "$sink_name" 2>/dev/null; then
            failures=$((failures + 1))
        fi
    done < <(
        pactl -f json list sink-inputs 2>/dev/null |
            jq -r '.[].index'
    )

    if ((failures > 0)); then
        notify-send -u normal "Audio output changed" \
            "$failures audio stream(s) closed before they could be moved."
    fi
}

select_asahi_sink() {
    local id

    id=$(sink_id)
    if [[ -z "$id" ]]; then
        notify-send -u critical "Laptop speakers unavailable" \
            "PipeWire did not expose the Asahi speaker node."
        return 1
    fi

    wpctl set-default "$id"
    pactl set-default-sink "$sink_name"
    if [[ "${1:-false}" == "true" ]]; then
        move_streams
    fi
}

if sink_available; then
    if [[ "$select_sink" == "true" ]]; then
        select_asahi_sink true
    fi
    exit 0
fi

hypr-network-audio-safe

mapfile -t cliamp_pids < <(pgrep -x cliamp || true)
if ((${#cliamp_pids[@]} > 0)); then
    for pid in "${cliamp_pids[@]}"; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue
        kill "$pid"
    done

    for _ in {1..20}; do
        cliamp_still_running=false
        for pid in "${cliamp_pids[@]}"; do
            [[ "$pid" =~ ^[0-9]+$ ]] || continue
            if kill -0 "$pid" 2>/dev/null; then
                cliamp_still_running=true
                break
            fi
        done
        [[ "$cliamp_still_running" == "false" ]] && break
        sleep 0.1
    done
fi

systemctl --user restart \
    pipewire.service \
    pipewire-pulse.service \
    wireplumber.service

stable_checks=0
for _ in {1..60}; do
    sleep 0.25
    hypr-network-audio-safe
    if sink_available; then
        stable_checks=$((stable_checks + 1))
        if ((stable_checks >= 8)); then
            break
        fi
    else
        stable_checks=0
    fi
done

if ((stable_checks < 8)); then
    notify-send -u critical "Laptop speakers unavailable" \
        "PipeWire did not restore the Asahi speaker sink."
    exit 1
fi

select_asahi_sink false
sleep 3
hypr-network-audio-safe

if ! sink_available || [[ $(pactl get-default-sink) != "$sink_name" ]]; then
    notify-send -u critical "Laptop speakers unavailable" \
        "The Asahi speaker sink did not remain selected."
    exit 1
fi

notify-send -u low "Laptop speakers restored" \
    "The Asahi audio processing sink is available again."
