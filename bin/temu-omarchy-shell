#!/usr/bin/env bash

set -euo pipefail

root=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
export OMARCHY_PATH="$root/vendor/omarchy"
export PATH="$OMARCHY_PATH/bin:$PATH"
shell_path="$OMARCHY_PATH/shell"

case "${1:-start}" in
    start)
        exec qs -p "$shell_path" --no-duplicate
        ;;
    ipc)
        shift
        exec timeout 2s qs ipc -n -p "$shell_path" call -- "$@"
        ;;
    toggle-bar)
        state_file="$HOME/.local/state/omarchy/toggles/bar-off"
        mkdir -p "$(dirname "$state_file")"
        if [[ -e "$state_file" ]]; then
            rm -f "$state_file"
        else
            touch "$state_file"
        fi
        "$0" ipc omarchy.bar syncHidden >/dev/null 2>&1 || true
        ;;
    *)
        printf 'Usage: %s [start|ipc TARGET METHOD [ARGS...]|toggle-bar]\n' \
            "$(basename "$0")" >&2
        exit 2
        ;;
esac
